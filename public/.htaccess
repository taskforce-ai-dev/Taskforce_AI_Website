# Enable mod_rewrite
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical host: force HTTPS + non-www -> www (single 301 hop)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^(.*)$ https://www.taskforceai.tech/$1 [R=301,L]

  # Every prerendered page is also reachable at its /index.html path, so each of
  # the ~55 pages had a duplicate URL answering 200. Redirect the explicit
  # filename to the directory form (the one the sitemap and canonical declare).
  #
  # The THE_REQUEST guard is essential: it matches only what the client actually
  # asked for, so LiteSpeed's own internal DirectoryIndex resolution of /about/
  # -> /about/index.html does NOT re-enter this rule. Without it this loops.
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /%1 [R=301,L]

  # Admin routes are client-side only (not prerendered) — serve the SPA shell so
  # React Router can handle them. Every other path that is not a real file/dir
  # falls through to a real 404 (see ErrorDocument below) instead of a soft 200.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^admin(/.*)?$ index.html [QSA,L]

  # Permanently removed blog posts. These four were prerendered long ago and
  # survived every deploy (the SCP step uses rm:false), so Google indexed them —
  # some still declaring canonical http://localhost:4173/. They were cleaned off
  # the server on 2026-07-28, but without these rules the /blog/* fallback below
  # would answer 200 for them and the noindex would only appear once JS ran.
  # 410 Gone is the strongest de-index signal and needs no rendering.
  RewriteRule ^blog/hello-world/?$ - [G,L]
  RewriteRule ^blog/talkforce-ai/?$ - [G,L]
  RewriteRule ^blog/taskforce-ai-faq-page/?$ - [G,L]
  RewriteRule ^blog/ai-voice-agent-sri-lanka-answer-every-call-without-hiring-a-receptionist/?$ - [G,L]

  # Blog routes are normally prerendered to static files (the !-f / !-d checks
  # skip this rule for them). A blog URL with no static file is either a
  # brand-new post not yet built, or a deleted/renamed/garbage slug. Serving the
  # homepage (index.html) for ALL of them — the old behaviour — turned every
  # non-existent /blog/ URL into a soft 404 (HTTP 200 homepage, canonical /).
  # Instead, hand off to blog-fallback.php, which asks WordPress whether the slug
  # exists: real post -> 200 + SPA shell (instant publish preserved), missing ->
  # a real 404. Known permanently-removed posts are already 410'd above and never
  # reach this.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^blog(/.*)?$ /blog-fallback.php [QSA,L]
</IfModule>

# Unknown URLs return a proper 404 status, served as the prerendered NotFound
# page (dist/404.html) — instead of the SPA shell with HTTP 200 (a soft 404).
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

# Enable compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Admin routes serve the SPA shell (see the rewrite above), so they answer 200
  # and were getting indexed as duplicates of the homepage. They stay crawlable
  # on purpose — robots.txt blocking them would stop Google fetching the page
  # and it would never see this header — but they are never indexable.
  SetEnvIf Request_URI "^/admin" TF_NOINDEX
  # The build cache JSON is a data artifact, not a page.
  SetEnvIf Request_URI "^/blog-cache\.json$" TF_NOINDEX
  Header set X-Robots-Tag "noindex, nofollow" env=TF_NOINDEX
</IfModule>
